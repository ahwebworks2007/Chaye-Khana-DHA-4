rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu Categories: Public Read & Admin Writes
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Menu Items: Public Read & Admin Writes
    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    // Cafe & Delivery Settings: Public Read & Admin Writes
    match /cafe_settings/{settingId} {
      allow read, write: if true;
    }

    // Orders: Public Read for tracking, Guest creation & status updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Admin Credentials: Store and authenticate credentials
    match /admin_users/{userId} {
      allow read, write: if true;
    }
  }
}

